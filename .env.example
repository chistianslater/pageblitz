# Pageblitz Environment Variables

# Database
DATABASE_URL=mysql://username:password@host:port/database

# Authentication
JWT_SECRET=your-jwt-secret-here
VITE_APP_ID=https://your-domain.com
OAUTH_SERVER_URL=https://your-oauth-server.com
OWNER_OPEN_ID=your-admin-open-id

# AI/LLM APIs
BUILT_IN_FORGE_API_URL=https://api.built-in-forge.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Pageblitz <noreply@your-domain.com>

# Stripe (for payments) - Get keys from Stripe Dashboard
# See documentation at https://docs.stripe.com/keys
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Add-on-Preise (Plan B6 Task 6): je Add-on eine wiederkehrende Stripe-Price-ID
# (monatlich, EUR, Brutto / tax_behavior=inclusive; Beträge siehe shared/pricing.ts:
# 3,90 € Standard, 9,90 € KI-Chat, 4,90 € Terminbuchung). Pflicht für den
# Stripe-Sync nach dem Checkout (Studio-Toggle, Dashboard-Kauf, Webhook
# customer.subscription.updated) — fehlt eine Variable, schlägt die Add-on-Änderung
# mit klarer Meldung fehl; der Checkout fällt auf Ad-hoc-Positionen zurück.
STRIPE_PRICE_ADDON_CONTACT_FORM=price_xxx
STRIPE_PRICE_ADDON_GALLERY=price_xxx
STRIPE_PRICE_ADDON_MENU=price_xxx
STRIPE_PRICE_ADDON_PRICELIST=price_xxx
STRIPE_PRICE_ADDON_AI_CHAT=price_xxx
STRIPE_PRICE_ADDON_BOOKING=price_xxx
STRIPE_PRICE_ADDON_TEAM=price_xxx
STRIPE_PRICE_ADDON_SUBPAGES=price_xxx

# Optional: Google Places API (for GMB integration)
GOOGLE_PLACES_API_KEY=your-google-places-api-key
